# Copy to .env for local development. On Render, set these in the service's Environment tab.

NODE_ENV=development
PORT=5000

# Contact form
RESEND_API_KEY=
RECIPIENT_EMAIL=

# On-site editor (editor.js, editorAuth.js)
# Login: run `npm run setup-editor`. It asks for a password, sets up your authenticator
# app, and prints all three values. Running it again resets them and logs everyone out.
EDITOR_PASSWORD_HASH=
EDITOR_TOTP_SECRET=
EDITOR_SESSION_SECRET=
# Login and lockout alerts go to RECIPIENT_EMAIL through Resend (above).
# Fine-grained GitHub token limited to this repository with
#   Contents: Read and write, Actions: Read (Metadata: Read is added automatically)
GITHUB_TOKEN=
GITHUB_REPO=Twoos123/asadali-portfolio
GITHUB_BRANCH=main
# true = save edits to the local src/content files instead of committing to GitHub
EDITOR_DRY_RUN=false
